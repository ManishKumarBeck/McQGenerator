# Copy this file to `.env` (in the project root) and fill in your values.
# `.env` is git-ignored — never commit real keys.

# --- AI generation (required to generate questions with AI) -----------------
# Get a key at https://platform.openai.com/api-keys
# (The legacy name OPENAI_KEY is also accepted.)
OPENAI_API_KEY=

# Chat model used for generation. gpt-4o-mini is fast and inexpensive;
# gpt-4o gives higher-quality questions at a higher cost.
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.4
# OPENAI_TIMEOUT_SECONDS=90
# OPENAI_MAX_RETRIES=2

# --- Database -----------------------------------------------------------------
# Defaults to a SQLite file at backend/data/mcq_exam.db (created automatically).
# Any SQLAlchemy URL works, e.g. PostgreSQL (requires `pip install psycopg[binary]`):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mcqgen

# --- Limits & behaviour ---------------------------------------------------------
# MAX_UPLOAD_MB=5
# MAX_SOURCE_CHARS=40000            # longer source text is truncated to save tokens
# MAX_QUESTIONS_PER_GENERATION=30
# SUBMISSION_GRACE_SECONDS=10       # network allowance for answers saved at the deadline

# --- Server ---------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# SERVE_FRONTEND=true               # serve frontend/dist from the API when it exists
# LOG_LEVEL=INFO
